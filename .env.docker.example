# Copy to .env.docker and replace every example value.
# On Linux, use: TEAMLEDGER_UID=$(id -u), TEAMLEDGER_GID=$(id -g).
TEAMLEDGER_UID=1000
TEAMLEDGER_GID=1000
TEAMLEDGER_BIND_ADDRESS=127.0.0.1
TEAMLEDGER_DOCKER_PORT=8443
TEAMLEDGER_PUBLIC_ORIGIN=https://localhost:8443

# Current v11 runtime still requires two Vault Transit-compatible HTTPS endpoints.
# DES-007 defines their future replacement by local teamledger-keyd; that code is not implemented yet.
TEAMLEDGER_KMS_URL=https://pii-kms.example.invalid
TEAMLEDGER_KMS_KEY=teamledger-pii
TEAMLEDGER_INTERVIEW_KMS_URL=https://interview-kms.example.invalid
TEAMLEDGER_INTERVIEW_KMS_KEY=teamledger-interview

# Keep authentication disabled only for isolated evaluation. Configure the full
# TEAMLEDGER_OIDC_* set before any real-user deployment.
TEAMLEDGER_OIDC_MODE=disabled
