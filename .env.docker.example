# Copy to .env.docker and replace every example value.
# On Linux, use your host UID/GID for TEAMLEDGER_UID/GID. Keep the keyd,
# maintenance, audit receiver and audit forwarder UIDs pairwise distinct.
TEAMLEDGER_UID=1000
TEAMLEDGER_KEYD_UID=10001
TEAMLEDGER_MAINTENANCE_UID=10002
TEAMLEDGER_AUDIT_RECEIVER_UID=10003
TEAMLEDGER_AUDIT_FORWARDER_UID=10004
TEAMLEDGER_GID=1000
TEAMLEDGER_BIND_ADDRESS=127.0.0.1
TEAMLEDGER_DOCKER_PORT=8443
TEAMLEDGER_PUBLIC_ORIGIN=https://localhost:8443

# Root/keyring are initialized exactly once with the explicit key-bootstrap
# command documented in README. They are mounted only into teamledger-keyd.
# SQLite database, audit ledger and outbox. Keep this name stable after install.
TEAMLEDGER_DATA_VOLUME=team-ledger-data
TEAMLEDGER_KEY_VOLUME=team-ledger-keys
TEAMLEDGER_BACKUP_DIR=./backups
# Offline media paths are host mounts used only by the offline-keys profile.
# Use two separately mounted removable filesystems in real operations.
TEAMLEDGER_OFFLINE_MEDIA_A=./offline-media-a
TEAMLEDGER_OFFLINE_MEDIA_B=./offline-media-b
TEAMLEDGER_OFFLINE_RESTORE_DIR=./offline-restore
TEAMLEDGER_AUDIT_VOLUME=team-ledger-audit
TEAMLEDGER_DEPLOYMENT_ID=teamledger-local
# Signer retirement defaults to the Compose SQLite database. PostgreSQL uses a
# root-owned 0600 DSN file and CA file under docker/audit-maintenance; see README.
TEAMLEDGER_AUDIT_MAINTENANCE_DB_BACKEND=sqlite
TEAMLEDGER_AUDIT_MAINTENANCE_DB_DSN=/var/lib/teamledger/teamledger.db
TEAMLEDGER_AUDIT_MAINTENANCE_DB_DSN_FILE=
TEAMLEDGER_AUDIT_MAINTENANCE_DB_CA_FILE=

# Identity mode is mandatory. Local mode requires one explicit identity-bootstrap
# run with a stable request UUID and docker/maintenance/local-bootstrap.json.
TEAMLEDGER_IDENTITY_MODE=local
TEAMLEDGER_BOOTSTRAP_REQUEST_ID=00000000-0000-4000-8000-000000000001
# Only used by the explicit v13→v14 key-domain acknowledgement profile.
# Replace with a new UUID immediately before that upgrade; never reuse it for another installation.
TEAMLEDGER_KEY_DOMAIN_ACK_REQUEST_ID=00000000-0000-4000-8000-000000000002
